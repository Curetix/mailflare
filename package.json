{
    "name": "mailflare",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "dev": "pnpm -r dev",
        "build": "pnpm -r build",
        "check-types": "pnpm -r check-types",
        "test": "pnpm -r test",
        "dev:web": "pnpm --filter @mailflare/web dev",
        "check": "oxlint && oxfmt --write",
        "prepare": "husky"
    },
    "devDependencies": {
        "@mailflare/config": "workspace:*",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxfmt": "^0.77.0",
        "oxlint": "^1.92.0",
        "typescript": "catalog:"
    },
    "lint-staged": {
        "*": [
            "oxfmt --write"
        ]
    },
    "packageManager": "pnpm@12.18.0"
}

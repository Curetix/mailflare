        "@cloudflare/vitest-plugin": "^1.8.2",
        "@cloudflare/workers-types": "^5.20261114.1",
        "drizzle-kit": "1.0.0-rc.5",
        "typescript": "catalog:",
        "vitest": "^5.1.0",
        "wrangler": "^4.162.0"
    }
}

{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mailflare",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-01",
    // better-auth needs AsyncLocalStorage.
    "compatibility_flags": ["nodejs_compat"],
    // Settings (PUBLIC_SIGNUPS, ADMIN_EMAILS, MAIL_FROM, ...) are set in the
    // dashboard; keep them across deploys. See README.md.
    "keep_vars": true,
    "observability": { "enabled": true },
    // Re-sends incoming mail (free to verified destinations) and sends from
    // aliases (arbitrary recipients: Workers Paid plan with a sending domain).
    "send_email": [{ "name": "EMAIL" }],
    "d1_databases": [
        {
            // No database_id: `wrangler deploy` creates the database on first deploy.
            "binding": "DB",
            "database_name": "mailflare",
            "migrations_dir": "migrations",
            "migrations_pattern": "migrations/*/migration.sql",
        },
    ],
}
